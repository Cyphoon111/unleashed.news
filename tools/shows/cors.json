{
  "rules": [
    {
      "allowed": {
        "origins": ["https://www.unleashed.news", "https://unleashed.news", "http://localhost:8766"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "Content-Type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
